{
  "expo": {
    "name": "KRAFT",
    "slug": "kraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kraft.atleta",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F1ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.kraft.atleta"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-audio",
      "expo-splash-screen",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "KRAFT añade tus clases reservadas a tu calendario."
        }
      ]
    ],
    "scheme": "kraft",
    "experiments": {
      "typedRoutes": true
    }
  }
}
