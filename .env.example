# Copia este archivo como .env.local (no se sube a git) y rellénalo.

# App (públicas: también van en Vercel → Settings → Environment Variables)
EXPO_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=tu_clave_publica_anon_o_publishable
# Formas de entrar activadas en Supabase: email | email,apple | email,apple,google
EXPO_PUBLIC_AUTH_PROVIDERS=email

# Solo para scripts/semilla.ts, desde el ordenador. NUNCA en Vercel ni en la app.
SUPABASE_SERVICE_ROLE_KEY=
